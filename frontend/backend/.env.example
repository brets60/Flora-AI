# FloraAI Environment Configuration
PROJECT_NAME=FloraAI
API_V1_STR=/api
SECRET_KEY=flora-botanical-secret-key-super-secure-production-ready-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: SQLite for zero-setup local dev; or postgresql://user:pass@host:5432/flora for Supabase/PostgreSQL
DATABASE_URL=sqlite:///./flora.db

# Google Gemini API Key for vision plant identification and plant doctor chat
# Obtain a free key at: https://aistudio.google.com/app/apikey
# If left empty, FloraAI seamlessly operates using its built-in botanical knowledge engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Media Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
