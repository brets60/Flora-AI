{
  "version": 2,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/FloraAI.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"FloraAI.apk\"" }
      ]
    },
    {
      "source": "/downloads/FloraAI.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"FloraAI.apk\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/downloads/FloraAI.apk", "destination": "/FloraAI.apk" },
    { "source": "/api/:path*", "destination": "/api/[...path].js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
